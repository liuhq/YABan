{
  "name": "tmp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "react-router dev",
    "predev": "pnpm run valkey:start",
    "postdev": "printf '\\nValkey is still running at 127.0.0.1:6379.\\nStop it with: pnpm run valkey:stop\\n'",
    "valkey:start": "valkey-cli -h 127.0.0.1 -p 6379 ping >/dev/null 2>&1 || valkey-server --bind 127.0.0.1 --port 6379 --save \"\" --appendonly no --daemonize yes --pidfile /tmp/yaban-valkey.pid --logfile /tmp/yaban-valkey.log",
    "valkey:stop": "valkey-cli -h 127.0.0.1 -p 6379 shutdown nosave",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@valkey/valkey-glide": "^2.5.2",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
